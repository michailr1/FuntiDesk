# FUNTIDESK: Linux service, from upstream res/rustdesk.service with FuntiDesk names
# (src/platform/linux.rs manages the unit by crate::get_app_name().to_lowercase()).
[Unit]
Description=FuntiDesk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/funtidesk --service
# kill --tray and --server both
ExecStop=/usr/bin/pkill -f "funtidesk --"
PIDFile=/run/funtidesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
